<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Planritning Magelungen</title>
  <style>
    body {
      font-family: sans-serif;
      margin: 0;
      background: #f5f5f5;
    }

    .container {
      position: relative;
      max-width: 1000px;
      margin: 0 auto;
    }

    .planritning {
      width: 100%;
      height: auto;
      display: block;
    }

    .hotspot {
      position: absolute;
      width: 30px;
      height: 30px;
      background-color: #007BFF;
      color: white;
      border-radius: 50%;
      text-align: center;
      line-height: 30px;
      cursor: pointer;
      font-weight: bold;
      border: 2px solid white;
      box-shadow: 0 0 6px rgba(0,0,0,0.3);
    }

    .tooltip {
      display: none;
      position: absolute;
      background: white;
      border: 1px solid #ccc;
      padding: 10px;
      max-width: 200px;
      z-index: 10;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }

    .hotspot:hover + .tooltip,
    .hotspot:focus + .tooltip {
      display: block;
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="Magelungen/magelungen-planritning.png" alt="Planritning Magelungen" class="planritning">

    <!-- Entré -->
    <div class="hotspot" style="top: 20%; left: 10%;" tabindex="0">?</div>
    <div class="tooltip" style="top: 25%; left: 10%;">Här är du i entrén. En öppen yta där man först kommer in.</div>

    <!-- Lounge -->
    <div class="hotspot" style="top: 30%; left: 40%;" tabindex="0">?</div>
    <div class="tooltip" style="top: 35%; left: 40%;">Här är loungen, en plats för vila och informella samtal.</div>

    <!-- Kök -->
    <div class="hotspot" style="top: 50%; left: 70%;" tabindex="0">?</div>
    <div class="tooltip" style="top: 55%; left: 70%;">Här ligger köket – en sensorisk plats med ljud och lukt.</div>

    <!-- Klassrum -->
    <div class="hotspot" style="top: 65%; left: 30%;" tabindex="0">?</div>
    <div class="tooltip" style="top: 70%; left: 30%;">Här är klassrummet där undervisningen sker.</div>

  </div>
</body>
</html>
