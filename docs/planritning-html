<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <title>Planritning – Magelungen</title>
  <style>
    body {
      font-family: sans-serif;
      margin: 2rem;
      background-color: #f7f7f7;
    }

    .image-container {
      position: relative;
      display: inline-block;
      margin-bottom: 50px;
    }

    .planritning {
      max-width: 100%;
      height: auto;
      border: 2px solid #ccc;
      border-radius: 8px;
    }

    .info-icon {
      position: absolute;
      width: 24px;
      height: 24px;
      background-color: #007bff;
      color: white;
      font-weight: bold;
      border-radius: 50%;
      text-align: center;
      line-height: 24px;
      cursor: pointer;
    }

    .tooltip {
      display: none;
      position: absolute;
      background-color: white;
      color: #333;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 200px;
      z-index: 100;
    }

    .info-icon:hover + .tooltip,
    .info-icon:focus + .tooltip {
      display: block;
    }
  </style>
</head>
<body>

  <h1>Planritning – Magelungen</h1>

  <div class="image-container">
    <img src="Magelungen/Magelungen1.png" alt="Planritning med zoner" class="planritning">

    <!-- Entré -->
    <div class="info-icon" style="top: 15%; left: 10%;">?</div>
    <div class="tooltip" style="top: 18%; left: 10%;">
      Här kommer du in – Entrén. Ljud, ljus och många intryck kan förekomma här.
    </div>

    <!-- Lounge -->
    <div class="info-icon" style="top: 30%; left: 35%;">?</div>
    <div class="tooltip" style="top: 33%; left: 35%;">
      Loungeområde – plats för att vänta, varva ner och anpassa sig.
    </div>

    <!-- Kök -->
    <div class="info-icon" style="top: 50%; left: 60%;">?</div>
    <div class="tooltip" style="top: 53%; left: 60%;">
      Här är köket. Doft av mat och sorl kan förekomma.
    </div>

    <!-- Klassrum -->
    <div class="info-icon" style="top: 70%; left: 40%;">?</div>
    <div class="tooltip" style="top: 73%; left: 40%;">
      Klassrummet – lugn zon för koncentration och instruktioner.
    </div>
  </div>

  <h2>Sensorikbild</h2>
  <img src="Magelungen/Magelungen2.png" alt="Sensorisk plan" class="planritning">

</body>
</html>
